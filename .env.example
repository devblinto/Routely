# Copy to apps/web/.env for local development.
#
# apps/web/.env — not .env.local — is the single local env file, because it is the one both
# Next.js and the Prisma CLI read. Every variable is validated on boot by apps/web/src/env.ts,
# so an invalid value fails fast with a message naming the offending variable.
#
# All values below are PLACEHOLDERS. Never commit real secrets.

# ---------------------------------------------------------------------------
# Database — required
# ---------------------------------------------------------------------------

# Matches the credentials in infra/docker-compose.dev.yml.
# In the production Docker stack the host is the service name, not localhost:
#   postgresql://USER:PASSWORD@postgres:5432/routely?schema=public
DATABASE_URL="postgresql://routely:routely@localhost:5432/routely?schema=public"

# ---------------------------------------------------------------------------
# Authentication — required in production
# ---------------------------------------------------------------------------

# Auth.js session/token encryption key. At least 32 characters.
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-character-random-string"

# Canonical public origin. This is Auth.js v5's replacement for NEXTAUTH_URL.
#
# It matters in production: `trustHost` is enabled so the app works behind the Nginx reverse
# proxy, and an explicit origin is what stops a forged Host header from redirecting the OAuth
# callback somewhere else. Production value: https://app.example.com
AUTH_URL="http://localhost:3000"

# Google OAuth 2.0 credentials from https://console.cloud.google.com/apis/credentials
#
# Authorised JavaScript origin:  http://localhost:3000
# Authorised redirect URI:       http://localhost:3000/api/auth/callback/google
# In production, the same two values using your real origin.
GOOGLE_CLIENT_ID="replace-with-your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-with-your-client-secret"

# Development-only bypass that grants a placeholder session so the dashboard can be browsed
# without Google credentials. Forced off whenever NODE_ENV=production.
# Set this to "false" once the Google credentials above are real.
AUTH_DEV_BYPASS="true"

# ---------------------------------------------------------------------------
# Application — optional
# ---------------------------------------------------------------------------

# Public origin of the dashboard, used for absolute links and install snippets.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Tracking SDK — optional
# ---------------------------------------------------------------------------

# Absolute URL of the SDK bundle, as it appears in the install snippet customers paste into
# their sites. Public by necessity — every visitor's browser fetches it.
#
# Leave unset and the app serves the bundle from its own origin at NEXT_PUBLIC_APP_URL/sdk.js,
# which is what the snippet will show. Set it to move the bundle to a CDN in production:
# NEXT_PUBLIC_SDK_URL="https://cdn.example.com/sdk.js"
#
# Changing it does not break anything already installed — existing snippets keep loading from
# the URL they were generated with, so keep the old URL serving the bundle until customers
# update their sites.

# API origin baked into the SDK bundle at build time (used by the SDK to call back home).
# ROUTELY_API_BASE="http://localhost:3000"

# ---------------------------------------------------------------------------
# Docker Compose — production stack only, see infra/
# ---------------------------------------------------------------------------

# POSTGRES_USER="routely"
# POSTGRES_PASSWORD="replace-with-a-strong-password"
# POSTGRES_DB="routely"
